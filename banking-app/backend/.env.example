PORT=3001

# ── Auth Server A: User / Frontend auth server ──────────────────────────────
# Issues access tokens when users sign in to the banking frontend.
# The banking REST API validates these tokens.
# The PointGuardAI Gateway reads the user's x-user-token issued by this server.
OKTA_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_A_ID
OKTA_AUDIENCE=api://banking

# ── Auth Server B: MCP / Exchange auth server ────────────────────────────────
# Performs the OBO (RFC 8693) token exchange requested by the PG Gateway.
# Auth Server B TRUSTS Auth Server A (see OKTA_SETUP.md Step 3).
# The banking MCP server validates these tokens (different issuer + audience).
OKTA_MCP_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_B_ID
OKTA_MCP_AUDIENCE=api://banking-mcp

# ── Database & misc ──────────────────────────────────────────────────────────
DB_PATH=./banking.db
FRONTEND_URL=http://localhost:5173

# ── OBO / Dev Tools ───────────────────────────────────────────────────────────
# Used by the /dev-tools page in the frontend (pre-fills the OBO Verifier form).
OBO_SERVER_B_TOKEN_URL=https://YOUR_OKTA_DOMAIN/oauth2/YOUR_SERVER_B_ID/v1/token
OBO_GW_CLIENT_ID=YOUR_GATEWAY_CLIENT_ID
OBO_GW_CLIENT_SECRET=YOUR_GATEWAY_CLIENT_SECRET
OBO_EXPECTED_AUD=api://banking-mcp
OBO_SCOPES=accounts:read accounts:balance:read accounts:transactions:read payments:read
