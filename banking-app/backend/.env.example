PORT=3001

# ── Auth Server A: User / Frontend auth server ──────────────────────────────
# Issues access tokens when users sign in to the banking frontend.
# The banking REST API validates these tokens.
# The PointGuardAI Gateway reads the user's x-user-token issued by this server.
OKTA_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_A_ID
OKTA_AUDIENCE=api://banking

# ── Auth Server B: MCP / Exchange auth server ────────────────────────────────
# Performs the OBO (RFC 8693) token exchange requested by the PG Gateway.
# Auth Server B TRUSTS Auth Server A (see OKTA_SETUP.md Step 3).
# The banking MCP server validates these tokens (different issuer + audience).
OKTA_MCP_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_B_ID
OKTA_MCP_AUDIENCE=api://banking-mcp

# ── Database & misc ──────────────────────────────────────────────────────────
DB_PATH=./banking.db
FRONTEND_URL=http://localhost:5173

# ── OBO / Dev Tools ───────────────────────────────────────────────────────────
# Used by the /dev-tools page in the frontend (pre-fills the OBO Verifier form).
OBO_SERVER_B_TOKEN_URL=https://YOUR_OKTA_DOMAIN/oauth2/YOUR_SERVER_B_ID/v1/token
OBO_GW_CLIENT_ID=YOUR_GATEWAY_CLIENT_ID
OBO_GW_CLIENT_SECRET=YOUR_GATEWAY_CLIENT_SECRET
OBO_EXPECTED_AUD=api://banking-mcp
OBO_SCOPES=accounts:read accounts:balance:read accounts:transactions:read payments:read

# ── Warden relay (browser -> this backend -> Warden) ──────────────────────────
# The frontend holds no Warden credential. This backend calls Warden as your TWO existing agents:
#   banking agent -> MCP tool calls      A2A agent -> Credit Card Agent (A2A)
# Each agent token is that agent's identity, so it is the one secret kept on the server. Put them in
# .env.local (git-ignored), NOT in this file:
#   WARDEN_AGENT_TOKEN=wag_...          (the banking agent's token)
#   WARDEN_A2A_AGENT_TOKEN=wag_...      (the A2A agent's token)
# The shared Warden API key is NOT stored locally: it is read from the Warden Credential Vault at runtime,
# under a vault policy that lets each of those two agents "reveal" it. Leave the next line empty if the
# virtual server has no active API keys (the vault is then not contacted).
WARDEN_URL=http://localhost:3003
WARDEN_VIRTUAL_SERVER_ID=
WARDEN_MCP_SERVER_ID=
WARDEN_A2A_VS_ID=
WARDEN_A2A_TARGET_ID=
WARDEN_API_KEY_SECRET=warden-api-key

# ── Optional: require Warden's gateway key on /mcp ────────────────────────────
# /mcp trusts the JWT it is given, so anything that can reach this port could forge a user. Setting this makes
# /mcp demand an X-Gateway-Key that only Warden holds (brokered from the Credential Vault; agents never see it).
# Do not set it by hand: `npm run gateway-key -- enable` generates the key, vaults it, and writes this hash to
# .env.local. Unset = open (previous behaviour); malformed = the backend refuses to start.
# MCP_GATEWAY_KEY_SHA256=
# Virtual server that hosts the shared chat-scan interceptors (the chat scans every message through it)
WARDEN_CHAT_VS_ID=
