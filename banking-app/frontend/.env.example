# Auth Server A — User / Frontend auth server (OKTA_SETUP.md Step 1)
# This is what users sign in against. Do NOT use Auth Server B here.
VITE_OKTA_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_A_ID

# Client ID of the "SecureBank Frontend" SPA app (OKTA_SETUP.md Step 6)
VITE_OKTA_CLIENT_ID=YOUR_OKTA_CLIENT_ID

VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
VITE_API_BASE_URL=http://localhost:3001/api
