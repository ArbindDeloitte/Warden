# ── PointGuardAI Gateway ─────────────────────────────────────────────────────
PG_GATEWAY_URL=https://your-pg-gateway.pointguardai.com
PG_GATEWAY_TOKEN=your_pg_gateway_api_token
PG_VIRTUAL_SERVER_ID=your_virtual_server_id
PG_AGENT_NAME=banking-agent

# ── User's token (from Auth Server A, obtained via PKCE login) ───────────────
# Leave blank to be prompted on startup (PKCE flow or manual paste).
USER_TOKEN=

# ── Okta config for automatic PKCE token acquisition ────────────────────────
OKTA_ISSUER=https://demo-arbind-lochan-mishra.okta.com/oauth2/YOUR_SERVER_A_ID
OKTA_CLIENT_ID=YOUR_OKTA_CLIENT_ID
OKTA_REDIRECT_PORT=8765

# ── Anthropic / AWS Bedrock ──────────────────────────────────────────────────
# Bedrock bearer token (from your AWS Bedrock console or bedrock-api-key)
ANTHROPIC_API_KEY=bedrock-api-key-YOUR_KEY_HERE
# Bedrock Anthropic endpoint
ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
# Claude model ID (Bedrock cross-region inference profile)
AGENT_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
