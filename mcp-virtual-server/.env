# Server
PORT=3003
NODE_ENV=development

# Redis (OBO token cache)
REDIS_URL=redis://localhost:6379

# SQLite path (relative to project root)
SQLITE_PATH=./data/virtual-server.db

# JWT Verification - set per virtual server, but global fallback
# JWKS_URI=https://your-okta-domain/oauth2/default/v1/keys

# Okta OBO settings (can also be set per virtual server in the UI)
# OKTA_ISSUER=https://your-okta-domain/oauth2/default
# OKTA_CLIENT_ID=your-client-id
# OKTA_CLIENT_SECRET=your-client-secret

# Session secret for UI (change in production)
SESSION_SECRET=change-me-in-production

# OBO cache TTL buffer (refresh at this % of token lifetime, default 80%)
OBO_REFRESH_THRESHOLD=0.8
PRESIDIO_ANALYZER_URL=http://localhost:5001

# Ollama — used by LlamaGuardScanner (async, audit-only, never blocks)
# Point this at any machine running Ollama if not running locally
OLLAMA_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3

# Embedding Scanner similarity threshold (default 0.85, range 0.0–1.0)
EMBEDDING_THRESHOLD=0.85